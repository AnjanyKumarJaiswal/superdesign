{
    "compilerOptions": {
        "target": "ES2020",
        "lib": [
            "ES2020"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist",
        "rootDir": ".",
        "typeRoots": [
            "./node_modules/@figma"
        ]
    },
    "include": [
        "code.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}