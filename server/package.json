{
  "name": "server",
  "version": "1.0.0",
  "description": "Standalone tRPC server with LangGraph orchestration for SuperDesign",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch -r dotenv/config -r tsconfig-paths/register index.ts",
    "build": "tsc",
    "start": "node -r dotenv/config -r tsconfig-paths/register dist/index.js",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist .turbo node_modules",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^1.35.0",
    "@langchain/core": "^0.3.15",
    "@langchain/langgraph": "^0.2.45",
    "@modelcontextprotocol/sdk": "^1.19.1",
    "@trpc/server": "^11.0.0-rc.544",
    "@types/cookie-parser": "^1.4.9",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.12.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "tsconfig-paths": "^4.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5"
  }
}
