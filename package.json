{
  "name": "superdesign",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "server/plugin"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:client": "turbo run dev --filter=client",
    "dev:server": "turbo run dev --filter=server",
    "build": "turbo run build",
    "build:client": "turbo run build --filter=client",
    "build:server": "turbo run build --filter=server",
    "start": "turbo run start",
    "start:client": "turbo run start --filter=client",
    "start:server": "turbo run start --filter=server",
    "lint": "turbo run lint",
    "lint:client": "turbo run lint --filter=client",
    "lint:server": "turbo run lint --filter=server",
    "type-check": "turbo run type-check",
    "type-check:client": "turbo run type-check --filter=client",
    "type-check:server": "turbo run type-check --filter=server",
    "clean": "turbo run clean && rm -rf node_modules",
    "clean:client": "turbo run clean --filter=client",
    "clean:server": "turbo run clean --filter=server",
    "db:migrate": "turbo run db:migrate --filter=server",
    "db:push": "turbo run db:push --filter=server",
    "db:studio": "turbo run db:studio --filter=server",
    "db:seed": "turbo run db:seed --filter=server",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:dev:detach": "docker-compose -f docker-compose.dev.yml up -d --build",
    "docker:prod": "docker-compose up --build",
    "docker:prod:detach": "docker-compose up -d --build",
    "docker:down": "docker-compose down",
    "docker:down:dev": "docker-compose -f docker-compose.dev.yml down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v --rmi all",
    "plugin:build": "turbo run build --filter=superdesign-figma-plugin",
    "plugin:watch": "turbo run watch --filter=superdesign-figma-plugin"
  },
  "devDependencies": {
    "turbo": "^2.5.5",
    "typescript": "^5.9.0"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.14.0",
    "yarn": ">=1.22.19"
  }
}